NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/bangla_scan
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PUBLIC_URL=http://localhost:5000
CLIENT_URL=http://localhost:5000,http://localhost:3000
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Site administrator
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Bangla Scan <noreply@example.com>
MAX_FILE_SIZE_MB=5

HOST=127.0.0.1
STORAGE_DRIVER=local
# MEDIA_DIRECTORY defaults to backend/data/media

# Optional S3 compatible storage. Keep the bucket private.
S3_PROVIDER_LABEL=Amazon S3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_PREFIX=bangla-scan/
S3_FORCE_PATH_STYLE=false
# Optional dedicated credential encryption key (32+ characters). Keep it stable.
STORAGE_ENCRYPTION_KEY=
# Set only when deploying behind a known reverse proxy.
TRUST_PROXY_HOPS=

# Keep this stable for authenticator secrets (32+ random characters).
# Defaults to JWT_SECRET when omitted. Back it up before enabling MFA.
AUTH_ENCRYPTION_KEY=
# Credential attempts per IP per 15 minutes; account throttles also apply.
AUTH_RATE_LIMIT_MAX=20
